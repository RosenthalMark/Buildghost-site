{
  "cleanUrls": true,
  "routes": [
    { "src": "/api/plane/(.*)", "dest": "/api/plane?path=$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/triage-desk/assets/(.*)", "dest": "/triage-desk/assets/$1" },
    { "src": "/triage-desk/demo", "dest": "/triage-desk/index.html" },
    { "src": "/triage-desk/demo/(.*)", "dest": "/triage-desk/index.html" },
    { "src": "/demo", "dest": "/triage-desk/index.html" },
    { "src": "/demo/(.*)", "dest": "/triage-desk/index.html" },
    { "src": "/triage/demo", "dest": "/triage-desk/index.html" },
    { "src": "/triage/demo/(.*)", "dest": "/triage-desk/index.html" },
    { "src": "/triage-desk", "dest": "/triage-desk/index.html" },
    { "src": "/triage-desk/(.*)", "dest": "/triage-desk/index.html" },
    { "src": "/triage", "dest": "/triage-desk/index.html" },
    { "src": "/triage/(.*)", "dest": "/triage-desk/index.html" },
    { "src": "/issues", "dest": "/triage-desk/index.html" },
    { "src": "/issues/(.*)", "dest": "/triage-desk/index.html" },
    { "handle": "filesystem" }
  ]
}
